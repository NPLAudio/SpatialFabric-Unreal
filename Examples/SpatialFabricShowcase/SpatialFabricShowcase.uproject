    {"Name": "SequencerScripting", "Enabled": true, "TargetAllowList": ["Editor"]},
    {"Name": "ModelContextProtocol", "Enabled": false},
    {"Name": "MCPClientToolset", "Enabled": false},
    {"Name": "AllToolsets", "Enabled": false}
  ]
}
